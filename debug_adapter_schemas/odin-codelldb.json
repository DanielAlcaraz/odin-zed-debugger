{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Odin CodeLLDB Debug Configuration",
  "type": "object",
  "properties": {
    "adapter": {
      "type": "string",
      "enum": ["odin-codelldb"],
      "description": "Debug adapter name"
    },
    "label": {
      "type": "string",
      "description": "Display name for this debug configuration"
    },
    "request": {
      "type": "string",
      "enum": ["launch", "attach"],
      "description": "Type of debug request"
    },
    "program": {
      "type": "string",
      "description": "Absolute path to the executable to debug. Can use Zed variables like $ZED_WORKTREE_ROOT"
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Command line arguments to pass to the program",
      "default": []
    },
    "cwd": {
      "type": "string",
      "description": "Working directory for the program. Supports Zed variables",
      "default": "${workspaceFolder}"
    },
    "environment": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Environment variables to set for the program",
      "default": {}
    },
    "stopOnEntry": {
      "type": "boolean",
      "description": "Stop at the main function entry point",
      "default": false
    },
    "initCommands": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "LLDB commands to execute during debugger initialization",
      "default": []
    },
    "preRunCommands": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "LLDB commands to execute after initialization but before running",
      "default": []
    },
    "postRunCommands": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "LLDB commands to execute after the program exits",
      "default": []
    },
    "sourceLanguages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "A list of source languages used by the program",
      "default": ["odin"]
    },
    "sourceMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Map source file paths for debugging (remote path -> local path)",
      "default": {}
    },
    "relativePathBase": {
      "type": "string",
      "description": "Base path for resolving relative source paths"
    },
    "preLaunchTask": {
      "type": "string",
      "description": "Name of a task to run before launching the debugger"
    },
    "postDebugTask": {
      "type": "string",
      "description": "Name of a task to run after the debug session ends"
    },
    "build": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "description": "Build command to execute"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Arguments for the build command"
        },
        "cwd": {
          "type": "string",
          "description": "Working directory for the build command"
        }
      },
      "required": ["command"],
      "description": "Optional build configuration to run before debugging"
    },
    "processId": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        }
      ],
      "description": "Process ID to attach to (for attach requests)"
    },
    "pid": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        }
      ],
      "description": "Alias for processId"
    },
    "waitFor": {
      "type": "boolean",
      "description": "Wait for the process to be launched before attaching",
      "default": false
    },
    "console": {
      "type": "string",
      "enum": ["internalConsole", "integratedTerminal", "externalTerminal"],
      "description": "Where to launch the debug target",
      "default": "internalConsole"
    },
    "terminal": {
      "type": "string",
      "enum": ["integrated", "external", "console"],
      "description": "Alternative way to specify console type"
    },
    "internalConsoleOptions": {
      "type": "string",
      "enum": ["neverOpen", "openOnSessionStart", "openOnFirstOutput"],
      "description": "Controls when the internal console should open",
      "default": "openOnFirstOutput"
    },
    "showInlineValues": {
      "type": "boolean",
      "description": "Show inline variable values in the editor",
      "default": true
    },
    "expressions": {
      "type": "string",
      "enum": ["simple", "python", "native"],
      "description": "Expression evaluator type",
      "default": "simple"
    },
    "cargo": {
      "type": "object",
      "description": "Rust/Cargo specific settings (if applicable)",
      "properties": {
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "filter": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "kind": {
              "type": "string"
            }
          }
        }
      }
    },
    "stdio": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ],
      "description": "Stdio redirection configuration"
    }
  },
  "required": ["adapter", "label", "request"],
  "allOf": [
    {
      "if": {
        "properties": {
          "request": {
            "const": "launch"
          }
        }
      },
      "then": {
        "required": ["program"]
      }
    },
    {
      "if": {
        "properties": {
          "request": {
            "const": "attach"
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "required": ["processId"]
          },
          {
            "required": ["pid"]
          }
        ]
      }
    }
  ]
}
